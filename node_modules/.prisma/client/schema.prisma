datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  picture       String
  createdAt     DateTime       @default(now())
  Organizations Organization[] //a user have many organization
}

model File_Information {
  file_id       String   @id @default(uuid())
  file_Name     String
  file_size     Int
  file_Type     String
  total_Page    Int
  status        Boolean
  parsing_Time  DateTime @db.Time
  date          DateTime @db.Date
  credit_Points Float
}

model Organization {
  Organization_Id   String    @id @default(uuid())
  Oragnization_Name String    @default("Default")
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  CreatedAt         DateTime  @default(now())
  projects          Project[] //One to many relationship with project
}

model Project {
  Porject_Name    String
  Project_Id      String       @id @default(uuid())
  CreatedAt       DateTime     @db.Date
  Organization_Id String //foreign key referencing organization id
  organization    Organization @relation(fields: [Organization_Id], references: [Organization_Id]) //relationship to organization
}

model Sign_Up_For_WaitList {
  Full_Name             String
  email                 String  @unique
  Text_Document_And_Pdf Boolean
  Csvs_And_Excel        Boolean
  Images                Boolean
  Others                String
  Company_Size          Int
  Title                 String
  LinkedIn_Url          String
  Saas                  Boolean
  Onprimise_Deployment  Boolean
}
